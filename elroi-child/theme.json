{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{
					"slug": "base",
					"name": "White",
					"color": "#FFFFFF"
				},
				{
					"slug": "contrast",
					"name": "Black text",
					"color": "#16181D"
				},
				{
					"slug": "accent-1",
					"name": "Black",
					"color": "#16181D"
				},
				{
					"slug": "accent-2",
					"name": "Cream",
					"color": "#FAF5EA"
				},
				{
					"slug": "accent-3",
					"name": "Night black",
					"color": "#0C0E12"
				},
				{
					"slug": "accent-4",
					"name": "Grey text",
					"color": "#4A5058"
				},
				{
					"slug": "accent-5",
					"name": "Soft white (text on dark)",
					"color": "#F3F5F8"
				},
				{
					"slug": "accent-6",
					"name": "Lines",
					"color": "#E8E0CE"
				},
				{
					"slug": "gold",
					"name": "Blue (buttons and highlights)",
					"color": "#1E63D6"
				},
				{
					"slug": "gold-deep",
					"name": "Deep blue (links and labels)",
					"color": "#174BA6"
				},
				{
					"slug": "sky",
					"name": "Light blue (highlights on dark)",
					"color": "#8DB9FF"
				},
				{
					"slug": "on-gold",
					"name": "Text on blue",
					"color": "#FFFFFF"
				}
			]
		},
		"layout": {
			"contentSize": "820px",
			"wideSize": "1180px"
		},
		"typography": {
			"fontFamilies": [
				{
					"name": "Playfair Display",
					"slug": "playfair",
					"fontFamily": "\"Playfair Display\", Georgia, serif",
					"fontFace": [
						{
							"src": [
								"file:./assets/fonts/PlayfairDisplay-Variable.woff2"
							],
							"fontWeight": "400 900",
							"fontStyle": "normal",
							"fontFamily": "Playfair Display",
							"fontDisplay": "swap"
						},
						{
							"src": [
								"file:./assets/fonts/PlayfairDisplay-Variable-Italic.woff2"
							],
							"fontWeight": "400 900",
							"fontStyle": "italic",
							"fontFamily": "Playfair Display",
							"fontDisplay": "swap"
						}
					]
				},
				{
					"name": "Inter",
					"slug": "inter",
					"fontFamily": "Inter, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
					"fontFace": [
						{
							"src": [
								"file:./assets/fonts/Inter-Variable.woff2"
							],
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontFamily": "Inter",
							"fontDisplay": "swap"
						},
						{
							"src": [
								"file:./assets/fonts/Inter-Variable-Italic.woff2"
							],
							"fontWeight": "100 900",
							"fontStyle": "italic",
							"fontFamily": "Inter",
							"fontDisplay": "swap"
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.0625rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.15rem",
					"fluid": {
						"min": "1.05rem",
						"max": "1.15rem"
					}
				},
				{
					"slug": "x-large",
					"name": "X-Large",
					"size": "1.6rem",
					"fluid": {
						"min": "1.35rem",
						"max": "1.8rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "XX-Large",
					"size": "2.4rem",
					"fluid": {
						"min": "1.6rem",
						"max": "2.4rem"
					}
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "3.8rem",
					"fluid": {
						"min": "2.2rem",
						"max": "3.8rem"
					}
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1rem"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--gold-deep)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--gold)"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--accent-3)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--playfair)",
					"fontWeight": "700",
					"lineHeight": "1.2",
					"letterSpacing": "0"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--display)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "1.25rem"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "1.1rem"
				}
			},
			"button": {
				"border": {
					"radius": "999px"
				},
				"color": {
					"background": "var(--wp--preset--color--gold)",
					"text": "var(--wp--preset--color--on-gold)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--inter)",
					"fontWeight": "600",
					"fontSize": "0.95rem"
				},
				"spacing": {
					"padding": {
						"top": "0.85rem",
						"bottom": "0.85rem",
						"left": "1.6rem",
						"right": "1.6rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--gold-deep)",
						"text": "var(--wp--preset--color--on-gold)"
					}
				}
			}
		}
	}
}
